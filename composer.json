{
    "name": "noopstudios/laravel-commerce",
    "description": "Orders, payments and allocations for Laravel, tying EuPago payments to Moloni invoices, with an optional Filament plugin.",
    "keywords": ["laravel", "orders", "payments", "eupago", "moloni", "filament"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "noopstudios/laravel-moloni": "*"
    },
    "require-dev": {
        "filament/filament": "^5.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "noopstudios/laravel-eupago": "*",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^4.0 || ^5.0"
    },
    "suggest": {
        "noopstudios/laravel-eupago": "Required for Multibanco and MB WAY payments.",
        "filament/filament": "Required for the orders and payments panel plugin (^5.0)."
    },
    "repositories": [
        {"type": "path", "url": "../laravel-moloni"},
        {"type": "path", "url": "../laravel-eupago"}
    ],
    "autoload": {
        "psr-4": {
            "Noop\\Commerce\\": "src/",
            "Noop\\Commerce\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noop\\Commerce\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Noop\\Commerce\\CommerceServiceProvider"
            ],
            "aliases": {
                "Commerce": "Noop\\Commerce\\Facades\\Commerce"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
